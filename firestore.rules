rules_version = '2';
// Sikkerhedsregler for Plejer.
// Kun husstandens medlemmer kan læse og ændre husstandens opgaver, medlemmer og log.
// Man bliver medlem ved at kende invitationskoden: koden slår husstandens id op,
// og id'et er tilfældigt og kan ikke gættes eller listes.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function household(hid) { return get(/databases/$(db)/documents/households/$(hid)); }
    function isMember(hid) { return signedIn() && me() in household(hid).data.members; }

    // Hver bruger har ét dokument, der peger på husstanden.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Invitationskoder. Kan slås op én ad gangen, men ikke listes.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isMember(request.resource.data.hid);
      allow update, delete: if signedIn() && isMember(resource.data.hid);
    }

    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false;
      // Den der opretter, skal selv være eneste medlem.
      allow create: if signedIn() && request.resource.data.members == [me()];
      // Medlemmer kan ændre navn, kode og medlemsliste.
      allow update: if isMember(hid)
        // Ny deltager: må kun tilføje sig selv til medlemslisten.
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [me()].toSet()
            && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && me() == uid;
        // Man kan forlade husstanden selv. Profiler uden telefon (børn) kan rettes af alle medlemmer.
        allow delete: if isMember(hid);
      }

      match /profiles/{pid} {
        allow read, write: if isMember(hid);
      }

      match /tasks/{tid} {
        allow read, write: if isMember(hid);
      }

      // Én linje pr. registrering. Bruges til historik og point. Kan ikke rettes bagefter, kun fortrydes.
      match /log/{lid} {
        allow read, create, delete: if isMember(hid);
        allow update: if false;
      }
    }
  }
}
